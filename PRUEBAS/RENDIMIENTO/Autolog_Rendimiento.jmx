            </elementProp>
          </collectionProp>
        </elementProp>
        <stringProp name="HTTPSampler.domain"></stringProp><stringProp name="HTTPSampler.port"></stringProp><stringProp name="HTTPSampler.protocol"></stringProp>
        <stringProp name="HTTPSampler.path">/api/ordenes/</stringProp>
        <stringProp name="HTTPSampler.method">POST</stringProp>
        <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
        <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        <stringProp name="TestPlan.comments"></stringProp>
      </HTTPSamplerProxy>
      <hashTree>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Calcular fecha_turno válida" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Turno a 30 días, corrido al siguiente día hábil, en hora en punto aleatoria 07–17 hs (RF-TU-01)
def d = java.time.LocalDate.now().plusDays(30)
while (d.dayOfWeek.value &gt; 5) { d = d.plusDays(1) }
def hora = 7 + new Random().nextInt(11)
vars.put("fecha_turno", String.format("%sT%02d:00:00", d.toString(), hora))</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Código de respuesta esperado (201)" enabled="true">
          <collectionProp name="Asserion.test_strings"><stringProp name="0">201</stringProp></collectionProp>
          <stringProp name="Assertion.custom_message"></stringProp>
          <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
          <boolProp name="Assertion.assume_success">false</boolProp>
          <intProp name="Assertion.test_type">8</intProp>
        </ResponseAssertion>
        <hashTree/>
        <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion" testname="Duración ≤ umbral (RNF-RD-02)" enabled="true">
          <stringProp name="DurationAssertion.duration">${__P(umbral_ms,2000)}</stringProp>
        </DurationAssertion>
        <hashTree/>
        <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extraer orden_id" enabled="true">
          <stringProp name="JSONPostProcessor.referenceNames">orden_id</stringProp>
          <stringProp name="JSONPostProcessor.jsonPathExprs">$.id</stringProp>
          <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
          <stringProp name="JSONPostProcessor.defaultValues">NO_ENCONTRADO</stringProp>
        </JSONPostProcessor>
        <hashTree/>
      </hashTree>
