        <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
          <collectionProp name="Arguments.arguments">
            <elementProp name="" elementType="HTTPArgument">
              <boolProp name="HTTPArgument.always_encode">false</boolProp>
              <stringProp name="Argument.value">{"cliente":${cliente_id},"vehiculo":${vehiculo_id},"taller":${__P(taller_id,1)},"fecha_turno":"${fecha_turno}","kilometraje":65000,"mantenimiento":"preventivo","responsable_tecnico":"Tecnico Perf","observaciones_tecnicas":"Creada por JMeter"}</stringProp>
