{
  "info": {
    "name": "Autolog — Plan de pruebas de servicios",
    "description": "Colección Postman para los 5 casos de prueba documentados en TESTSERVICES.md. Orden recomendado de ejecución: 1 → 3 → 5 → 4 → 2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "autolog-tests-2026"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "admin_username", "value": "admin", "type": "string" },
    { "key": "admin_password", "value": "Admin123!", "type": "string" },
    { "key": "cliente_username", "value": "cliente1", "type": "string" },
    { "key": "cliente_password", "value": "Cliente123!", "type": "string" },
    { "key": "tecnico_username", "value": "tecnico1", "type": "string" },
    { "key": "tecnico_password", "value": "Tecnico123!", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "role", "value": "", "type": "string" },
    { "key": "cliente_origen_id", "value": "", "type": "string" },
    { "key": "cliente_destino_id", "value": "", "type": "string" },
    { "key": "vehiculo_id", "value": "", "type": "string" },
    { "key": "taller_id", "value": "", "type": "string" },
    { "key": "agenda_id", "value": "", "type": "string" },
    { "key": "orden_id", "value": "", "type": "string" },
    { "key": "orden_pasada_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. [AU-01] Login JWT (tecnico)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/token/",
          "host": ["{{base_url}}"],
          "path": ["api", "token", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{tecnico_username}}\",\n  \"password\": \"{{tecnico_password}}\"\n}"
        },
        "description": "Obtiene access/refresh/role para el tecnico. Guarda los tokens en variables de coleccion."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Tiene access token', () => pm.expect(json).to.have.property('access'));",
              "pm.test('Tiene refresh token', () => pm.expect(json).to.have.property('refresh'));",
              "pm.test('Claim role valido', () => pm.expect(json.role).to.be.oneOf(['admin','tecnico','cliente']));",
              "pm.collectionVariables.set('access_token', json.access);",
              "pm.collectionVariables.set('refresh_token', json.refresh);",
              "pm.collectionVariables.set('role', json.role);"
            ]
          }
        }
      ]
    },
    {
      "name": "1b. [AU-01] Login JWT (cliente origen) — usar antes del test 2",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/token/",
          "host": ["{{base_url}}"],
          "path": ["api", "token", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{cliente_username}}\",\n  \"password\": \"{{cliente_password}}\"\n}"
        },
        "description": "Re-login como cliente para poder transferir titularidad."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('role == cliente', () => pm.expect(json.role).to.eql('cliente'));",
              "pm.collectionVariables.set('access_token', json.access);",
              "pm.collectionVariables.set('refresh_token', json.refresh);",
              "pm.collectionVariables.set('role', json.role);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. [OT-01] Crear Orden de Trabajo (preventiva)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/ordenes/",
          "host": ["{{base_url}}"],
          "path": ["api", "ordenes", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cliente\": {{cliente_origen_id}},\n  \"vehiculo\": {{vehiculo_id}},\n  \"taller\": {{taller_id}},\n  \"fecha_turno\": \"2026-06-15T10:00:00\",\n  \"kilometraje\": 41000,\n  \"mantenimiento\": \"preventivo\",\n  \"observaciones_tecnicas\": \"Service de 40.000 km\",\n  \"responsable_tecnico\": \"Carlos Tecnico\"\n}"
        },
        "description": "Crea OT preventiva. El backend asigna agenda automaticamente y calcula proximo service. Requiere login como tecnico (Test 1)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "const ot = pm.response.json();",
              "pm.test(\"Estado inicial 'pendiente'\", () => pm.expect(ot.estado).to.eql('pendiente'));",
              "pm.test('Calculo fecha_siguiente_servicio', () => pm.expect(ot.fecha_siguiente_servicio).to.not.be.null);",
              "pm.test('Calculo kilometraje_siguiente_servicio', () => {",
              "  pm.expect(ot.kilometraje_siguiente_servicio).to.be.a('number');",
              "  pm.expect(ot.kilometraje_siguiente_servicio).to.be.greaterThan(ot.kilometraje);",
              "});",
              "pm.test('Asigno agenda', () => pm.expect(ot.agenda).to.not.be.null);",
              "pm.collectionVariables.set('orden_id', ot.id);",
              "pm.collectionVariables.set('agenda_id', ot.agenda);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. [TU-02] Consultar turnos asignados",
      "request": {
        "method": "GET",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/agendas/{{agenda_id}}/turnos-asignados/?fecha=2026-06-15",
          "host": ["{{base_url}}"],
          "path": ["api", "agendas", "{{agenda_id}}", "turnos-asignados", ""],
          "query": [{ "key": "fecha", "value": "2026-06-15" }]
        },
        "description": "Lista turnos asignados a la agenda, opcionalmente filtrado por fecha. Verifica que la OT del Test #3 aparezca."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const arr = pm.response.json();",
              "pm.test('Devuelve array', () => pm.expect(arr).to.be.an('array'));",
              "pm.test('OT del Test #3 aparece', () => {",
              "  const ids = arr.map(o => o.id);",
              "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('orden_id')));",
              "});",
              "pm.test('Ordenado por fecha_turno asc', () => {",
              "  for (let i = 1; i < arr.length; i++) {",
              "    pm.expect(new Date(arr[i].fecha_turno) >= new Date(arr[i-1].fecha_turno)).to.be.true;",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. [OT-04] Anular Orden de Trabajo (orden_pasada_id)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/ordenes/{{orden_pasada_id}}/anular/",
          "host": ["{{base_url}}"],
          "path": ["api", "ordenes", "{{orden_pasada_id}}", "anular", ""]
        },
        "body": { "mode": "raw", "raw": "{}" },
        "description": "Anula una OT cuyo turno ya paso. Requiere login como tecnico del mismo taller."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"estado == 'anulada'\", () => pm.expect(json.estado).to.eql('anulada'));",
              "pm.test(\"status == 'ok'\", () => pm.expect(json.status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. [VH-04] Transferir titularidad (correr al final)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/vehiculo/{{vehiculo_id}}/transferir-titularidad/",
          "host": ["{{base_url}}"],
          "path": ["api", "vehiculo", "{{vehiculo_id}}", "transferir-titularidad", ""]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nuevo_propietario_id\": {{cliente_destino_id}}\n}"
        },
        "description": "Transfiere titularidad del vehiculo al cliente_destino_id. IMPORTANTE: requiere estar logueado como cliente_origen (correr 1b antes)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Detalle confirma transferencia', () => {",
              "  pm.expect(pm.response.json().detail).to.include('transferida');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
