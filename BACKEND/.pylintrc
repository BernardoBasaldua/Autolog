[MAIN]
# [REG #1] Habilitamos el plugin de Django para evitar falsos positivos en .objects, DoesNotExist, etc.
load-plugins = pylint_django

# [REG #2] Ignoramos carpetas de ruido (no se lintéan): entorno, caches y migraciones.
ignore = CVS, env, __pycache__, migrations

# [REG #3] Hook portátil para todo el equipo:
#   - agrega el cwd al sys.path (importaciones relativas funcionan)
#   - setea DJANGO_SETTINGS_MODULE para que Pylint conozca tu settings
#   Ajustá "autolog.settings" si tu paquete principal se llama distinto.
init-hook = 'import os, sys; sys.path.insert(0, os.getcwd()); os.environ.setdefault("DJANGO_SETTINGS_MODULE","autolog.settings")'

# (Config del entorno; no la contamos como regla, pero conviene ajustarla a tu versión real)
py-version = 3.13


[TYPECHECK]
# [REG #4] “Red de seguridad” por si el plugin no se carga: tratá estos miembros como válidos en Django.
generated-members = objects, DoesNotExist


[FORMAT]
# [REG #5] Límite de largo de línea (Black también usa 100). Alinea el equipo con una sola cifra.
max-line-length = 100


[BASIC]
# [REG #6] Convenciones de nombres PEP 8 Python Enhancement Proposal (Propuesta de Mejora de Python) (snake_case para funciones/vars/métodos/módulos; PascalCase para clases; UPPER_CASE para constantes).
argument-naming-style = snake_case
attr-naming-style = snake_case
class-naming-style = PascalCase
const-naming-style = UPPER_CASE
function-naming-style = snake_case
method-naming-style = snake_case
module-naming-style = snake_case
variable-naming-style = snake_case


[DESIGN]
# [REG #7] Complejidad: tope de argumentos por función/método
max-args = 5

# [REG #8] Complejidad: tope de ramas por función
max-branches = 12

# [REG #9] Complejidad: tope de returns por función
max-returns = 6

# [REG #10] Tamaño de función: tope de sentencias
max-statements = 50

# [EXTRA] DRF genera herencia profunda: si molesta "too-many-ancestors", preferimos bajar por clase
# con  # pylint: disable=too-many-ancestors
# (Si igual querés alivianar globalmente, dejamos un tope más alto)
max-parents = 12


[EXCEPTIONS]
# [EXTRA] Buenas prácticas: evitar capturar excepciones demasiado genéricas
overgeneral-exceptions = builtins.BaseException, builtins.Exception


[MESSAGES CONTROL]
# [EXTRA] Silenciamos docstrings obligatorios (módulos, clases, funciones) para evitar ruido mientras avanzan.
disable = missing-module-docstring, missing-class-docstring, missing-function-docstring
